PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/algogrowthhub
CORS_ORIGIN=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=algogrowthhub_super_secret_access_jwt_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=algogrowthhub_super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin (For Seeding)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@algogrowthhub.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Payment Provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Media Storage: local | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
